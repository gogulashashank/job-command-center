{
  "manifest_version": 3,
  "name": "JCC Web Clipper",
  "version": "1.0",
  "description": "Clip jobs from LinkedIn directly into Job Command Center",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:3000/*", "https://*.supabase.co/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to JCC"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
